# Laundristic — local environment variables
#
# Copy this file to `.env` (in the repo root) and fill in the real values.
# `.env` is gitignored — never commit real tokens.
#
# Only used by `scripts/sync-confluence.mjs` (npm run sync:docs).
# The PWA itself has no runtime env vars; this is dev-only.

# Your Atlassian Cloud domain (no protocol, no trailing slash).
# Example: yourname.atlassian.net
CONFLUENCE_DOMAIN=chandraprakashhingal.atlassian.net

# The Confluence space KEY (not the name). Read from the URL:
#   /wiki/spaces/<KEY>/  →  here, the space "Laundristic" lives under key "TH".
CONFLUENCE_SPACE_KEY=TH

# Your Atlassian account email (the one that owns the API token).
CONFLUENCE_EMAIL=chandraprakash.hingal@gmail.com

# Atlassian API token. Generate at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Treat this like a password. Never paste it in chat, commits, or screenshots.
# If it ever leaks, revoke it on that page and issue a new one.
CONFLUENCE_API_TOKEN=REPLACE_ME

# (Optional) Parent page ID to nest all mirrored pages under.
# Read from the page URL: .../pages/<ID>/<slug>
# Leave blank to create at the space root.
# 96632833 is the existing "Laundristic" landing page.
CONFLUENCE_PARENT_ID=96632833
